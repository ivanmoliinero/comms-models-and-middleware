#!/bin/bash

# Update the system packages
yum update -y

# Install Docker
yum install docker -y

# Start and enable the Docker service to run on boot
systemctl start docker
systemctl enable docker

# Add the default user to the Docker group
usermod -aG docker ec2-user

# Define the Redis configuration variables
REDIS_PASS="admin123"

# 1. Run the Redis Master container
# We enforce the strict replication rules to prevent split-brain data loss
# NOTE: Masterauth must be included to ensure reconnection if the node is destroyed.
docker run -d \
  --name redis-server \
  --net host \
  --restart always \
  redis:latest \
  redis-server \
  --requirepass $REDIS_PASS \
  --masterauth $REDIS_PASS \
  --appendonly yes \
  --min-replicas-to-write 1 \
  --min-replicas-max-lag 10

# Wait loop: Blocks execution until the local Redis container is fully running
echo "Waiting for local Redis Master container to initialize..."
while ! docker exec redis-server redis-cli -a $REDIS_PASS ping | grep -q "PONG"; do
  sleep 5
done

# Retrieve the local private IP directly from the OS network interface
# This ensures Sentinel advertises a reachable network IP to external clients
LOCAL_IP=$(hostname -I | awk '{print $1}')

# 2. Configure Sentinel
# Sentinel requires a configuration file because it rewrites it dynamically
# when failovers occur.
mkdir -p /etc/redis
cat << EOF > /etc/redis/sentinel.conf
port 26379
# Quorum is set to 2 (requires 2 out of 3 sentinels to agree on a failure)
sentinel monitor mymaster $LOCAL_IP 6379 2
sentinel auth-pass mymaster $REDIS_PASS
sentinel down-after-milliseconds mymaster 5000
sentinel failover-timeout mymaster 10000
EOF

# Ensure the file is writable by the container
chmod 666 /etc/redis/sentinel.conf

# 3. Run the Sentinel container on the same host
docker run -d \
  --name redis-sentinel \
  --net host \
  --restart always \
  -v /etc/redis/sentinel.conf:/usr/local/etc/redis/sentinel.conf \
  redis:latest \
  redis-sentinel /usr/local/etc/redis/sentinel.conf

echo "Redis Master and Sentinel are fully operational."