#!/bin/bash

# Update the system packages
yum update -y

# Install Docker
yum install docker -y

# Start and enable the Docker service to run on boot
systemctl start docker
systemctl enable docker

# Add the default user to the Docker group
usermod -aG docker ec2-user

# Define the Redis configuration variables
REDIS_PASS="admin123"
MASTER_IP="${primary_ip}"

# 1. Run the Redis Replica container
# We also apply the min-replicas rules here so that if this replica is promoted
# to master, it inherits the strict data-loss prevention rules.
docker run -d \
  --name redis-server \
  --net host \
  --restart always \
  redis:latest \
  redis-server \
  --requirepass $REDIS_PASS \
  --masterauth $REDIS_PASS \
  --replicaof $MASTER_IP 6379 \
  --appendonly yes \
  --min-replicas-to-write 1 \
  --min-replicas-max-lag 10

# Wait loop: Blocks execution until the local Redis container is fully running
echo "Waiting for local Redis Replica container to initialize..."
while ! docker exec redis-server redis-cli -a $REDIS_PASS ping | grep -q "PONG"; do
  sleep 5
done

# 2. Configure Sentinel
# This sentinel MUST point to the MASTER_IP, not localhost.
mkdir -p /etc/redis
cat << EOF > /etc/redis/sentinel.conf
port 26379
sentinel monitor mymaster $MASTER_IP 6379 2
sentinel auth-pass mymaster $REDIS_PASS
sentinel down-after-milliseconds mymaster 5000
sentinel failover-timeout mymaster 10000
EOF

# Ensure the file is writable by the container
chmod 666 /etc/redis/sentinel.conf

# 3. Run the Sentinel container on the same host
docker run -d \
  --name redis-sentinel \
  --net host \
  --restart always \
  -v /etc/redis/sentinel.conf:/usr/local/etc/redis/sentinel.conf \
  redis:latest \
  redis-sentinel /usr/local/etc/redis/sentinel.conf

echo "Redis Replica and Sentinel are successfully running."