#!/bin/bash

# Update the system packages
yum update -y

# Install Docker
yum install docker -y

# Start and enable the Docker service to run on boot
systemctl start docker
systemctl enable docker

# Add the default user to the Docker group
usermod -aG docker ec2-user

# Define the Redis configuration variables
REDIS_PASS="admin123"

# Run the Redis container in cluster mode using the host network
docker run -d \
  --name redis-server \
  --net host \
  --restart always \
  redis:latest \
  redis-server \
  --requirepass $REDIS_PASS \
  --masterauth $REDIS_PASS \
  --cluster-enabled yes \
  --cluster-config-file nodes.conf \
  --cluster-node-timeout 5000 \
  --appendonly yes

# Wait loop: Blocks execution until the Redis application inside the container is fully running
echo "Waiting for Redis container to initialize..."
while ! docker exec redis-server redis-cli -a $REDIS_PASS ping | grep -q "PONG"; do
  sleep 5
done

echo "Secondary node ready and waiting for cluster assignment."